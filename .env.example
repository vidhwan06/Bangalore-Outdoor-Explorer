# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Bengaluru Outdoor Explorer"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bengaluru_outdoor?schema=public"

# Auth (placeholder - replace with actual provider)
AUTH_SECRET="your-auth-secret-min-32-chars-long"
NEXT_PUBLIC_AUTH_URL=http://localhost:3000/api/auth

# Maps (placeholder - replace with actual provider)
NEXT_PUBLIC_MAP_PROVIDER="mapbox"
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# Weather (placeholder)
WEATHER_PROVIDER="openweather"
OPENWEATHER_API_KEY=""

# Storage (placeholder)
STORAGE_PROVIDER="local"
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# AI (placeholder)
AI_PROVIDER="openai"
OPENAI_API_KEY=""

# Email (placeholder)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="noreply@bengaluruoutdoor.in"

# Feature flags
NEXT_PUBLIC_ENABLE_AI=false
NEXT_PUBLIC_ENABLE_COMMUNITY=false