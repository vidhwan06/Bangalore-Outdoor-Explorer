# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Bengaluru Outdoor Explorer"

# Database (PostgreSQL + PostGIS)
#
# This project uses Supabase's connection pooler. The two URLs serve different
# purposes and are NOT interchangeable:
#
#   DATABASE_URL  -> transaction-mode pooler (port 6543). Used by the Prisma
#                    Client at runtime (Next.js app, importer scripts). This is
#                    the port that must work for normal application traffic.
#   DIRECT_URL    -> session-mode pooler (port 5432). Used by the Prisma CLI
#                    for migrations and `prisma db pull`, which need a session
#                    that PgBouncer in transaction mode cannot provide.
#
# Replace the placeholders below with the values from your Supabase dashboard
# (Project Settings -> Database -> Connection string). Never commit real
# credentials: `.env` and `.env.local` are both gitignored.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# For a local Postgres instead of Supabase, use a single URL for both:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bengaluru_outdoor?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bengaluru_outdoor?schema=public"

# IMPORTANT: keep DATABASE_URL out of your OS/shell environment. Next.js does
# not override variables that already exist in process.env, so a stray
# persistent DATABASE_URL will silently shadow this file and the app will
# connect to the wrong database.

# Auth (placeholder - replace with actual provider)
AUTH_SECRET="your-auth-secret-min-32-chars-long"
NEXT_PUBLIC_AUTH_URL=http://localhost:3000/api/auth

# Maps (placeholder - replace with actual provider)
NEXT_PUBLIC_MAP_PROVIDER="mapbox"
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# Weather (placeholder)
WEATHER_PROVIDER="openweather"
OPENWEATHER_API_KEY=""

# Storage
#
# Place photos live in the Supabase Storage bucket `place-photos`, created by
# prisma/migrations/03_place_photo_provenance. The bucket is public for reads
# and has NO public write policy; all uploads go through the server using the
# service-role key below.
#
# STORAGE_PROVIDER accepts: local | s3 | cloudinary  (only "supabase" is wired)
STORAGE_PROVIDER="supabase"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Server-side only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# AI (placeholder)
AI_PROVIDER="openai"
OPENAI_API_KEY=""

# Email (placeholder)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="noreply@bengaluruoutdoor.in"

# Feature flags
NEXT_PUBLIC_ENABLE_AI=false
NEXT_PUBLIC_ENABLE_COMMUNITY=false
