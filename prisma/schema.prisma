generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  email         String    @unique
  name          String?
  avatarUrl     String?
  role          user_role @default(USER)
  emailVerified DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdPlaces Place[]   @relation("PlaceCreator")
  profile       Profile?

  @@index([email], map: "idx_user_email")
  @@index([role], map: "idx_user_role")
}

model Profile {
  id                 String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId             String   @unique
  bio                String?
  location           String?
  website            String?
  preferences        Json?
  totalVisits        Int      @default(0)
  totalContributions Int      @default(0)
  trustScore         Float    @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_profile_user")
}

model Place {
  id                String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name              String
  slug              String                   @unique
  description       String?
  shortDescription  String?
  category          place_category
  subcategory       String?
  location          Unsupported("geography")
  region            String?
  locality          String?
  difficulty        Int?
  trailDistanceKm   Float?
  durationHours     Float?
  elevationM        Int?
  elevationGainM    Int?
  openingTime       String?
  closingTime       String?
  lastEntryTime     String?
  entryFeeInr       Int?
  permitRequired    Boolean                  @default(false)
  permitDetails     String?
  permitUrl         String?
  hasParking        Boolean                  @default(false)
  parkingDetails    String?
  hasWater          Boolean                  @default(false)
  waterDetails      String?
  hasNetwork        Boolean                  @default(false)
  networkDetails    String?
  crowdLevel        Int?
  bestSeasonStart   Int?
  bestSeasonEnd     Int?
  status            place_status             @default(UNVERIFIED)
  trustScore        Float                    @default(0)
  trustLevel        trust_level              @default(COMMUNITY_SUBMITTED)
  visibilityLevel   visibility_level         @default(PUBLIC_EXACT)
  lastVerifiedAt    DateTime?                @db.Timestamptz(6)
  verificationNotes String?
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  createdById       String?
  sourceReferences  Json?
  officialSources   OfficialSource[]
  createdBy         User?                    @relation("PlaceCreator", fields: [createdById], references: [id], onUpdate: NoAction)
  photos            PlacePhoto[]
  videos            PlaceVideo[]

  @@index([category], map: "idx_place_category")
  @@index([locality], map: "idx_place_locality")
  @@index([location], map: "idx_place_location_gist", type: Gist)
  @@index([region], map: "idx_place_region")
  @@index([slug], map: "idx_place_slug")
  @@index([status], map: "idx_place_status")
  @@index([trustLevel], map: "idx_place_trust_level")
  @@index([visibilityLevel], map: "idx_place_visibility")
}

model PlacePhoto {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  placeId        String
  url            String
  thumbnailUrl   String?
  caption        String?
  photographerId String?
  isPrimary      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  place          Place    @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([placeId], map: "idx_place_photo_place")
  @@index([isPrimary], map: "idx_place_photo_primary")
}

model PlaceVideo {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  placeId      String
  url          String
  thumbnailUrl String?
  caption      String?
  duration     Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  place        Place    @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([placeId], map: "idx_place_video_place")
}

model OfficialSource {
  id            String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  placeId       String?
  name          String                   @unique
  type          verification_source_type
  url           String?
  contactEmail  String?
  contactPhone  String?
  description   String?
  isVerified    Boolean                  @default(false)
  lastCheckedAt DateTime?                @db.Timestamptz(6)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  place         Place?                   @relation(fields: [placeId], references: [id], onUpdate: NoAction)

  @@index([placeId], map: "idx_official_source_place")
  @@index([type], map: "idx_official_source_type")
}

enum place_category {
  TREK
  HIKE
  WATERFALL
  LAKE
  MOUNTAIN
  FOREST
  CAVE
  FORT
  VIEWPOINT
  CAMPING
  CYCLING
  SCENIC_DRIVE
  HIDDEN_GEM
}

enum place_status {
  OPEN
  PERMIT_REQUIRED
  LIMITED_SLOTS
  CLOSED
  WEATHER_CONCERN
  UNVERIFIED
}

enum trust_level {
  VERIFIED
  COMMUNITY_SUBMITTED
  INFORMATION_OUTDATED
  CLOSED_RESTRICTED
  UNDER_REVIEW
}

enum user_role {
  USER
  CONTRIBUTOR
  MODERATOR
  ADMIN
}

enum verification_source_type {
  OFFICIAL_GOVERNMENT
  OFFICIAL_PARK_AUTHORITY
  OFFICIAL_TOURISM_BOARD
  VERIFIED_CONTRIBUTOR
  COMMUNITY_REPORT
  SATELLITE_IMAGERY
  USER_VISIT
  THIRD_PARTY_API
}

enum visibility_level {
  PUBLIC_EXACT
  PUBLIC_APPROXIMATE
  VERIFIED_COMMUNITY_ONLY
  MODERATOR_ONLY
  PRIVATE
}
